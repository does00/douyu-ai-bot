# 复制为 .env 后填写。不要提交 .env 到 git。
# Copy to .env and fill in. Never commit .env.

# Web 管理后台密码（Basic Auth 用户名固定为 admin）
WEBUI_PASSWORD=change-me

# 直连模式：你的 Gemini API Key（https://aistudio.google.com/apikey）
GEMINI_API_KEY=

# 中继模式（二选一）：自建 Gemini 中继地址，留空则用内置默认
# 直连模式下请留空
GEMINI_RELAY_URL=

# 中继鉴权口令（自建中继时与中继端保持一致）
RELAY_TOKEN=

# 可选：HTTP 代理，如 http://127.0.0.1:8080；为空则直连
PROXY_URL=

# 可选：WebUI 监听端口 / 地址
WEBUI_PORT=18021
# WEBUI_HOST=0.0.0.0
